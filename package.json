{
  "name": "glosa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build-only && npx cap sync @capawesome/capacitor-electron",
    "cap:dev": "npm run build-only && npx cap sync @capawesome/capacitor-electron && npx cap run @capawesome/capacitor-electron",
    "cap:build": "npm run build && npx cap sync @capawesome/capacitor-electron && cd electron && npm run pack",
    "build:dmg": "npm run build && npx cap sync @capawesome/capacitor-electron && cd electron && npm run pack"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capawesome/capacitor-electron": "^0.2.0",
    "@capawesome/capacitor-file-picker": "^8.1.0",
    "@glosa/desktop-plugin": "file:./packages/glosa-desktop",
    "@tailwindcss/vite": "^4.3.1",
    "@tiptap/extension-code-block-lowlight": "^3.27.0",
    "@tiptap/extension-image": "^3.27.0",
    "@tiptap/extension-link": "^3.27.0",
    "@tiptap/extension-placeholder": "^3.27.0",
    "@tiptap/extension-table": "^3.27.0",
    "@tiptap/extension-task-item": "^3.27.0",
    "@tiptap/extension-task-list": "^3.27.0",
    "@tiptap/extension-typography": "^3.27.0",
    "@tiptap/pm": "^3.27.0",
    "@tiptap/starter-kit": "^3.27.0",
    "@tiptap/vue-3": "^3.27.0",
    "dexie": "^4.4.4",
    "lowlight": "^3.3.0",
    "material-symbols": "^0.47.6",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.1",
    "tiptap-markdown": "^0.9.0",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.5.0",
    "eslint-plugin-oxlint": "~1.69.0",
    "eslint-plugin-vue": "~10.9.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.69.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
